# Sao chép thành .env rồi chỉnh. Không commit file .env lên GitHub.

# ---- Chọn CSDL: mssql (chính thức) hoặc sqlite (chỉ để demo nhanh, không cần SQL Server)
DB_BACKEND=mssql
SQLITE_PATH=data/demo.db

# ---- SQL Server
SQL_SERVER=localhost            # ví dụ: localhost, localhost\SQLEXPRESS, 127.0.0.1,1433
SQL_DATABASE=HRSpO2Db
SQL_USER=sa
SQL_PASSWORD=doi_mat_khau_cua_ban
SQL_TRUSTED=0                   # 1 = dùng Windows Authentication (bỏ qua SQL_USER/SQL_PASSWORD)
SQL_DRIVER=ODBC Driver 18 for SQL Server
# DB_URL=                       # (tùy chọn) URL SQLAlchemy đầy đủ, ghi đè các mục trên

# ---- Hiển thị và ngưỡng
DISPLAY_TZ=Asia/Ho_Chi_Minh
EXPECTED_INTERVAL_S=2           # chu kỳ ESP32 gửi bản tin (giây)
GAP_FACTOR=2.5                  # khoảng cách > GAP_FACTOR x chu kỳ => mất dữ liệu
ONLINE_MAX_AGE_S=10
STALE_MAX_AGE_S=60

# ---- Cảnh báo DEMO (không phải ngưỡng chẩn đoán)
ALERT_HR_LOW=50
ALERT_HR_HIGH=120
ALERT_SPO2_WARN=94
ALERT_SPO2_CRIT=90

# ---- SpO2 đang là giá trị mô phỏng (1) hay đã có hiệu chuẩn thật (0)
SPO2_SIMULATED=1
